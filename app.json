{
  "expo": {
    "name": "EFMHPortfolio",
    "slug": "efmh-portfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "rw.ac.ines.ug2527950.efmhportfolio"
    },
    "android": {
      "package": "rw.ac.ines.ug2527950.efmhportfolio",
      "adaptiveIcon": {
        "backgroundColor": "#0A1417",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "EFMHPortfolio uses your photo library only to attach a profile or verification-card image stored on this phone.",
          "cameraPermission": "EFMHPortfolio uses the camera only to capture a profile or verification-card image stored on this phone."
        }
      ],
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "4f7405bc-685b-4d85-8589-db22f2e36357"
      }
    },
    "owner": "ehabhamid42-ctrl"
  }
}
